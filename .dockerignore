# Keep the build context small and reproducible.
.git
.gitignore
.claude
docs
example_logs
scripts
vendor
README.md
CLAUDE.md

# Build artifacts / caches — rebuilt inside the image
backend/bin
backend/data
backend/tests
**/.venv
**/__pycache__
**/*.pyc

# The compose/docker files themselves are not needed inside the image
Dockerfile
docker-compose.yml
.dockerignore
